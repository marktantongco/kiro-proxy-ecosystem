#!/usr/bin/env bash
# session-protect — inspect Freebuff session protection state.
#
# Shows:
#   • config          ~/.config/manicode/session-protect.conf (hardcoded protection)
#   • guard           freebuff-owner-guard.sh + systemd user service
#   • owner file      freebuff-instance-owner.json (instanceId, pid, alive?)
#   • version pin     freebuff-metadata.json (must be 999.999.999 to block auto-update)
#   • last RESTORED   recent ownership-restore events from the guard log
#
# Usage:
#   session-protect             status of all protection layers (exit 0 = all active)
#   session-protect --doctor    full 3-layer stack check in one invocation:
#                                 1. status output (config/guard/owner/pin/log)
#                                 2. raw launcher getCurrentVersion() decision
#                                 3. doctor.sh sections 11 (static) + 12 (dynamic)
#                               Exit 0 = GO, 1 = any layer failed, 2 = usage error
#
# Exit code: 0 if every protection layer is active, 1 otherwise.

DOCTOR="${FB2API_DOCTOR:-/home/ubuntu/ai-workspace/kiro-proxy-ecosystem/freebuff2api/scripts/doctor.sh}"
DOCTOR_MODE=0
case "${1:-}" in
  --doctor|-d) DOCTOR_MODE=1 ;;
  --help|-h)   sed -n '2,20p' "$0"; exit 0 ;;
  "")         : ;;
  *)           echo "usage: session-protect [--doctor]" >&2; exit 2 ;;
esac

CONF="$HOME/.config/manicode/session-protect.conf"
OWNER_FILE="$HOME/.config/manicode/freebuff-instance-owner.json"
META_FILE="$HOME/.config/manicode/freebuff-metadata.json"
GUARD_SCRIPT="/usr/local/bin/freebuff-owner-guard.sh"
GUARD_LOG="$HOME/.config/manicode/freebuff-owner-guard.log"
GUARD_SERVICE="freebuff-owner-guard.service"
EXPECTED_PIN="999.999.999"

GREEN=$'\033[1;32m'; RED=$'\033[1;31m'; YELLOW=$'\033[1;33m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'

say()  { printf '%s\n' "$*"; }
ok()   { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$RED" "$RESET" "$*"; }
warn() { printf '  %s⚠%s %s\n' "$YELLOW" "$RESET" "$*"; }
hdr()  { printf '\n%s%s%s\n' "$BOLD" "$*" "$RESET"; }

status=0

# ── 1. Config ────────────────────────────────────────────────────────────
hdr "config  $DIM($CONF)$RESET"
if [ -f "$CONF" ]; then
  ok "session-protect.conf exists"
  PROTECT=$(grep -c '^PROTECT_FROM_TAKEOVER=1' "$CONF" 2>/dev/null || echo 0)
  AUTOUP=$(grep -c '^BLOCK_AUTOUPDATE=1' "$CONF" 2>/dev/null || echo 0)
  TOKEN=$(grep '^SESSION_TOKEN=' "$CONF" 2>/dev/null | head -1 | cut -d= -f2)
  [ "$PROTECT" -ge 1 ] && ok "PROTECT_FROM_TAKEOVER=1" || { bad "PROTECT_FROM_TAKEOVER missing"; status=1; }
  [ "$AUTOUP" -ge 1 ]   && ok "BLOCK_AUTOUPDATE=1"     || { bad "BLOCK_AUTOUPDATE missing"; status=1; }
  [ -n "$TOKEN" ]       && ok "SESSION_TOKEN=$TOKEN"   || warn "SESSION_TOKEN unset"
else
  bad "session-protect.conf missing — no hardcoded protection"
  status=1
fi

# ── 2. Guard ─────────────────────────────────────────────────────────────
hdr "guard  $DIM($GUARD_SCRIPT + $GUARD_SERVICE)$RESET"
if [ -x "$GUARD_SCRIPT" ]; then
  ok "guard script installed"
else
  bad "guard script missing ($GUARD_SCRIPT)"
  status=1
fi
if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files "$GUARD_SERVICE" >/dev/null 2>&1; then
  EN=$(systemctl --user is-enabled "$GUARD_SERVICE" 2>/dev/null)
  AC=$(systemctl --user is-active  "$GUARD_SERVICE" 2>/dev/null)
  [ "$EN" = "enabled" ] && ok "service enabled"  || { warn "service enabled=$EN"; status=1; }
  [ "$AC" = "active" ]  && ok "service active"   || { warn "service active=$AC";  status=1; }
  GPID=$(systemctl --user show "$GUARD_SERVICE" -p MainPID --value 2>/dev/null)
  [ -n "$GPID" ] && [ "$GPID" != "0" ] && ok "guard pid $GPID" || warn "guard pid unknown"
else
  bad "systemd user service not found"
  status=1
fi
if pgrep -f 'freebuff-owner-guard.sh' >/dev/null 2>&1; then
  ok "guard process running"
else
  warn "guard process not observed (may be between checks)"
fi

# ── 3. Owner file ────────────────────────────────────────────────────────
hdr "owner  $DIM($OWNER_FILE)$RESET"
if [ -f "$OWNER_FILE" ]; then
  read -r IID PID < <(python3 -c '
import json,sys
try:
    d=json.load(open(sys.argv[1]))
    print(d.get("instanceId",""), d.get("pid",0))
except Exception:
    print("")
' "$OWNER_FILE" 2>/dev/null)
  if [ -n "$IID" ]; then
    ok "instanceId $IID"
  else
    bad "owner file unreadable/invalid"
    status=1
  fi
  if [ -n "$PID" ] && [ "$PID" != "0" ]; then
    if kill -0 "$PID" 2>/dev/null; then
      ok "pid $PID alive"
    else
      warn "pid $PID dead (stale — next instance can claim)"
    fi
  else
    warn "no pid recorded"
  fi
else
  bad "owner file missing"
  status=1
fi

# ── 4. Version pin ───────────────────────────────────────────────────────
hdr "version-pin  $DIM($META_FILE)$RESET"
if [ -f "$META_FILE" ]; then
  PIN=$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$META_FILE" 2>/dev/null | head -1 | grep -o '[0-9][^"]*')
  if [ "$PIN" = "$EXPECTED_PIN" ]; then
    ok "metadata pinned at $EXPECTED_PIN (auto-update blocked)"
  else
    bad "metadata version=$PIN (expected $EXPECTED_PIN) — launcher may kill session for update"
    status=1
  fi
else
  bad "metadata file missing"
  status=1
fi

# ── 5. Last RESTORED events ──────────────────────────────────────────────
hdr "guard-log  $DIM($GUARD_LOG)$RESET"
if [ -f "$GUARD_LOG" ]; then
  n=$(grep -c 'RESTORED\|restored' "$GUARD_LOG" 2>/dev/null || echo 0)
  ok "$n restore event(s) logged"
  tail -3 "$GUARD_LOG" | sed 's/^/  /'
else
  warn "no guard log yet (guard never ran or log rotated)"
fi

# ── 6. Launcher autoupdate decision (raw, real module) ────────────────────
# Dynamic launcher check is part of the full --doctor stack; the default
# status mode stays static so a changed launcher path can't flip it DEGRADED.
if [ "$DOCTOR_MODE" = 1 ]; then
  hdr "launcher  $DIM(/usr/local/lib/node_modules/freebuff/launcher.js)$RESET"
  LAUNCHER="/usr/local/lib/node_modules/freebuff/launcher.js"
  if [ -f "$LAUNCHER" ] && command -v node >/dev/null 2>&1; then
    lout=$(node -e '
      const { createLauncher } = require(process.argv[1])
      const l = createLauncher({ packageName: "freebuff", displayName: "Freebuff", includeTreeSitterWasm: true })
      const t = l.__testing
      const cur = t.getCurrentVersion()
      const defKey = (typeof t.getDefaultTargetKey === "function") ? t.getDefaultTargetKey() : "linux-x64"
      console.log("CURRENT=" + (cur === null ? "null" : cur))
      console.log("BINARY=" + (require("fs").existsSync(t.CONFIG.binaryPath) ? "yes" : "no"))
      console.log("ALLOWED=" + (t.isTargetAllowedForThisMachine ? t.isTargetAllowedForThisMachine(defKey) : true))
    ' "$LAUNCHER" 2>&1)
    lrc=$?
    lcur=$(echo "$lout" | sed -n 's/^CURRENT=//p')
    lbin=$(echo "$lout" | sed -n 's/^BINARY=//p')
    lall=$(echo "$lout" | sed -n 's/^ALLOWED=//p')
    if [ "$lrc" -eq 0 ] && [ -n "$lcur" ] && [ "$lcur" != "null" ] && [ "$lbin" = "yes" ]; then
      ok "getCurrentVersion()=$lcur (non-null), binary=$lbin, target allowed=$lall -> update triggered: false"
    else
      bad "autoupdate NOT blocked (cur=${lcur:-err} bin=${lbin:-?} allowed=${lall:-?}) — re-pin metadata"
      status=1
    fi
  else
    bad "launcher.js or node missing ($LAUNCHER) — cannot verify autoupdate block"
    status=1
  fi
fi

# ── 7. doctor.sh sections 11 + 12 (end-to-end validation) ─────────────────
if [ "$DOCTOR_MODE" = 1 ]; then
  hdr "doctor  $DIM(sections 11+12 of $DOCTOR)$RESET"
  if [ -f "$DOCTOR" ] && bash -n "$DOCTOR" 2>/dev/null; then
    # Chat checks (4/5) need the API key; grab it from the deployed .env if present.
    DKEY="${FB2API_API_KEY:-}"
    if [ -z "$DKEY" ] && [ -r /var/lib/freebuff2api/repo/.env ]; then
      DKEY=$(grep '^FREEBUFF_API_KEY=' /var/lib/freebuff2api/repo/.env 2>/dev/null | cut -d= -f2)
    fi
    DOUT_TMP=$(mktemp)
    FB2API_API_KEY="$DKEY" timeout 120 bash "$DOCTOR" >"$DOUT_TMP" 2>&1
    DRC=$?
    DRESULT=$(grep -E 'RESULT: (GO|NO-GO)' "$DOUT_TMP" | head -1)
    sed -n '/^== 11\./,/^RESULT/p' "$DOUT_TMP" | head -16 | sed 's/^/  /'
    rm -f "$DOUT_TMP"
    # Verdict comes from the doctor's OWN exit code (0=GO, 1=NO-GO) — not a
    # section-scoped FAIL count, which would miss failures in earlier sections.
    if [ "$DRC" -eq 0 ]; then
      ok "doctor: GO (exit 0)"
    else
      bad "doctor: ${DRESULT:-no RESULT} (exit $DRC) — see $DOCTOR"
      status=1
    fi
  else
    bad "doctor.sh not found/invalid ($DOCTOR) — set FB2API_DOCTOR"
    status=1
  fi
fi

say
if [ "$status" -eq 0 ]; then
  if [ "$DOCTOR_MODE" = 1 ]; then
    printf '%sSESSION-PROTECT --DOCTOR: ALL LAYERS ACTIVE (GO)%s\n' "$GREEN" "$RESET"
  else
    printf '%sSESSION-PROTECT: ALL LAYERS ACTIVE%s\n' "$GREEN" "$RESET"
  fi
else
  printf '%sSESSION-PROTECT: DEGRADED (%s issue%s)%s\n' "$RED" "$status" "$([ "$status" = 1 ] && echo '' || echo 's')" "$RESET"
fi
exit "$status"
